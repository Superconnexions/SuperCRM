<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SuperCRM</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/supercrm-grid-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SuperCRM.Web.styles.css" asp-append-version="true" />
</head>

<body class="supercrm-body">

    <header class="supercrm-header">
        <nav class="navbar navbar-expand-sm navbar-dark supercrm-navbar">
            <div class="container-fluid">

                <a class="navbar-brand supercrm-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    SuperCRM
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1"></ul>
                    <partial name="_LoginPartial" />
                </div>

            </div>
        </nav>
    </header>

    <div class="supercrm-page">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="supercrm-footer">
        <div class="container-fluid">
            &copy; 2026 - SuperCRM
            <span class="mx-2">|</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/calander.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>