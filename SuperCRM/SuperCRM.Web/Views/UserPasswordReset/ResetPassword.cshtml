@model SuperCRM.Web.ViewModels.UserPasswordReset.AdminResetUserPasswordViewModel
@{ ViewData["Title"] = "Reset User Password"; }
<div class="crm-page">
    <h2 class="crm-page-title">Reset User Password</h2>
    <div class="crm-grid-panel p-4" style="max-width:650px">
        <dl class="row">
            <dt class="col-sm-4">User Name</dt><dd class="col-sm-8">@Model.UserName</dd>
            <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd>
            <dt class="col-sm-4">User Type / Roles</dt><dd class="col-sm-8">@Model.UserType</dd>
            <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.IsActive ? "Active" : "Inactive")</dd>
        </dl>
        @if (!Model.IsActive)
        {
            <div class="alert alert-warning">Resetting the password will leave this account inactive.</div>
        }
        <form asp-action="ResetPassword" method="post">
            <input asp-for="UserId" type="hidden" />
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn crm-grid-btn-primary">Reset Password</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
