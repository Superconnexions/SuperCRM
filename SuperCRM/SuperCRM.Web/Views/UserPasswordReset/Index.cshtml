@model SuperCRM.Web.ViewModels.UserPasswordReset.UserPasswordResetListViewModel
@{ ViewData["Title"] = "User Password Reset"; }
<div class="crm-page">
    <h2 class="crm-page-title">User Password Reset</h2>
    <p>All active and inactive user accounts. User Type shows the assigned application roles.</p>
    @if (TempData["AdminPasswordResetSuccess"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }
    <form method="get" asp-action="Index" class="d-flex gap-2 mb-3 flex-wrap">
        <input name="search" value="@Model.Search" class="form-control" style="max-width:400px"
               placeholder="Search username, email or phone" aria-label="Search users" />
        <button class="btn crm-grid-btn-primary" type="submit">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Show All</a>
    </form>
    <p>@Model.TotalUsers user(s) — Page @Model.Page of @Model.TotalPages</p>
    <div class="crm-grid-panel table-responsive">
        <table class="crm-grid-table">
            <thead><tr>
                <th>User Name</th><th>Email</th><th>Phone</th><th>User Type / Roles</th>
                <th>Status</th><th>Email Confirmed</th><th>Created At (UTC)</th><th>Action</th>
            </tr></thead>
            <tbody>
            @foreach (var account in Model.Users)
            {
                <tr>
                    <td>@account.UserName</td><td>@account.Email</td><td>@account.PhoneNumber</td>
                    <td>@account.UserType</td><td>@(account.IsActive ? "Active" : "Inactive")</td>
                    <td>@(account.EmailConfirmed ? "Yes" : "No")</td>
                    <td class="text-nowrap">@account.CreatedAt.ToString("dd-MMM-yyyy HH:mm")</td>
                    <td class="text-nowrap"><a asp-action="ResetPassword" asp-route-id="@account.UserId"
                        class="btn btn-sm crm-grid-btn-warning">Reset Password</a></td>
                </tr>
            }
            @if (Model.Users.Count == 0)
            {
                <tr><td colspan="8" class="text-center p-4">No users found.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <nav class="d-flex gap-2 mt-3" aria-label="User list pages">
        @if (Model.Page > 1)
        {
            <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)" class="btn btn-secondary">Previous</a>
        }
        @if (Model.Page < Model.TotalPages)
        {
            <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)" class="btn btn-secondary">Next</a>
        }
    </nav>
</div>
