@using Microsoft.AspNetCore.Identity
@using SuperCRM.Persistence.Identity
@using SuperCRM.Shared
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager


@model SuperCRM.Application.DTOs.SalesOrders.AdminDashboardDto

@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>

    .admin-dashboard,
    .admin-dashboard * {
        font-family: Calibri, Arial, sans-serif;
        font-size: 10pt;
    }

    body {
        background: #222426;
    }

    /* // Added new */

    .btn-search-agent {
        background: #0d47ff;
        color: #ffffff;
        border: 4px solid #1d4ed8;
        border-radius: 14px;
        height: 48px;
        font-weight: 900;
    }

        .btn-search-agent:hover {
            background: #1d4ed8;
            color: #ffffff;
        }

    .btn-search-admin {
        background: #047857;
        color: #ffffff;
        border: 4px solid #059669;
        border-radius: 14px;
        height: 48px;
        font-weight: 900;
    }

        .btn-search-admin:hover {
            background: #059669;
            color: #ffffff;
        }

    .btn-search-all {
        background: #7c2d12;
        color: #ffffff;
        border: 4px solid #ea580c;
        border-radius: 14px;
        height: 48px;
        font-weight: 900;
    }

        .btn-search-all:hover {
            background: #ea580c;
            color: #ffffff;
        }

       /*  // Added END  */

    .admin-dashboard {
        background: #222426;
        color: #d6d6d6;
        padding: 18px;
        min-height: calc(100vh - 70px);
    }

    .dashboard-title {
        color: #0d47ff;
        font-size: 18pt;
        font-weight: 900;
        letter-spacing: .5px;
        margin-bottom: 4px;
        text-transform: uppercase;
    }

    .dashboard-subtitle {
        color: #b5b5b5;
        font-size: 12pt;
    }

    .filter-panel {
        background: #17191b;
        border: 2px solid #2d3033;
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 18px;
    }

    .filter-label {
        color: #ffffff;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .filter-control {
        background: #151719;
        border: 3px solid #3b3f44;
        border-radius: 12px;
        color: #d6d6d6;
        height: 44px;
        font-weight: 700;
    }

        .filter-control:focus {
            background: #151719;
            color: #ffffff;
            border-color: #0d47ff;
            box-shadow: none;
        }

    .btn-search {
        background: #101214;
        color: #ffffff;
        border: 5px solid #484b50;
        border-radius: 14px;
        height: 50px;
        font-weight: 900;
    }

        .btn-search:hover {
            color: #ffffff;
            border-color: #0d47ff;
        }

    .metric-card {
        background: #17191b;
        border: 2px solid #2d3033;
        border-radius: 10px;
        min-height: 120px;
        padding: 18px;
    }

        .metric-card:hover {
            border-color: #0d47ff;
            background: #1d2430;
        }

    .metric-label {
        color: #ffffff;
        font-size: 11pt;
        font-weight: 800;
    }

    .metric-value {
        color: #0d47ff;
        font-size: 24pt;
        font-weight: 900;
        margin-top: 10px;
        line-height: 1;
    }

    .metric-note {
        color: #c8c8c8;
        font-size: 10pt;
        margin-top: 10px;
    }

    .metric-link {
        text-decoration: none;
    }

    .dashboard-block {
        background: #17191b;
        border: 2px solid #2d3033;
        border-radius: 8px;
        overflow: hidden;
    }

    .dashboard-block-header {
        background: #000000;
        color: #ffffff;
        font-size: 12pt;
        font-weight: 800;
        padding: 14px 18px;
    }

    .dashboard-table {
        color: #d6d6d6;
        margin-bottom: 0;
    }

        .dashboard-table thead th {
            background: #000000;
            color: #d6d6d6;
            border-color: #2d3033;
            padding: 12px;
            font-size: 10pt;
            font-weight: 800;
            white-space: nowrap;
        }

        .dashboard-table tbody td {
            border-color: #2d3033;
            padding: 12px;
            vertical-align: middle;
            color: #d6d6d6;
        }

        .dashboard-table tbody tr {
            background: #17191b;
        }

            .dashboard-table tbody tr:nth-child(even) {
                background: #1b1d20;
            }

            .dashboard-table tbody tr:hover {
                background: #2c3440 !important;
            }

                .dashboard-table tbody tr:hover td {
                    color: #ffffff !important;
                }

                .dashboard-table tbody tr:hover a {
                    color: #66a3ff !important;
                }

    .blue-text {
        color: #0d47ff;
        font-weight: 800;
    }

    .status-pill {
        color: #0d6efd;
        font-weight: 800;
        text-decoration: underline;
    }

    .count-pill {
        color: #ffffff;
        background: #0d47ff;
        border-radius: 18px;
        padding: 4px 12px;
        font-weight: 800;
    }

    .empty-row {
        text-align: center;
        color: #b5b5b5;
        padding: 18px !important;
    }

    .btn-view {
        color: #0d6efd;
        font-weight: 800;
        text-decoration: underline;
        background: transparent;
        border: none;
        padding: 0;
    }

    .text-nowrap {
        white-space: nowrap;
    }


    .btn-search-agent {
    background: #0d47ff;
    color: white;
    border: 3px solid #1d4ed8;
    border-radius: 12px;
    height: 46px;
    font-weight: 800;
}

.btn-search-admin {
    background: #047857;
    color: white;
    border: 3px solid #059669;
    border-radius: 12px;
    height: 46px;
    font-weight: 800;
}

.btn-search-all {
    background: #ea580c;
    color: white;
    border: 3px solid #fb923c;
    border-radius: 12px;
    height: 46px;
    font-weight: 800;
}

.btn-search-agent:hover,
.btn-search-admin:hover,
.btn-search-all:hover {
    color: white;
}




</style>

<div class="admin-dashboard">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="dashboard-title">Admin Dashboard</h3>
            <div class="dashboard-subtitle">
                Monitor all customers, sales orders and commission performance.
            </div>
        </div>

        <a asp-controller="SalesOrder"
           asp-action="SalesOrderManagement"
           class="btn-search text-decoration-none d-flex align-items-center px-4">
            Sales Order Management
        </a>
    </div>

    <form asp-controller="Admin"
          asp-action="Index"
          method="get"
          class="filter-panel">

        <div class="row g-3 align-items-end">

            <div class="col-md-3">

                <label class="filter-label">
                    Search by Agent
                </label>

                <select name="agentUserId"
                        class="form-select filter-control">

                    <option value="">Select Agent</option>

                    @foreach (var item in Model.AgentOptions)
                    {
                        <option value="@item.UserId">
                            @item.DisplayText
                        </option>
                    }

                </select>

            </div>

            <div class="col-md-2">

                <button type="submit"
                        name="searchMode"
                        value="Agent"
                        class="btn btn-search-agent">
                    Search Agent
                </button>

            </div>

            <div class="col-md-3">

                <label class="filter-label">
                    Search by Admin
                </label>

                <select name="adminUserId"
                        class="form-select filter-control">

                    <option value="">Select Admin</option>

                    @foreach (var item in Model.AdminOptions)
                    {
                        <option value="@item.UserId">
                            @item.DisplayText
                        </option>
                    }

                </select>

            </div>

            <div class="col-md-2">

                <button type="submit"
                        name="searchMode"
                        value="Admin"
                        class="btn btn-search-admin">
                    Search Admin
                </button>

            </div>

            <div class="col-md-2">

                <button type="submit"
                        name="searchMode"
                        value="All"
                        class="btn btn-search-all">
                    Search All
                </button>

            </div>

        </div>

    </form>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <a asp-controller="SalesOrder" asp-action="CustomerManagement" class="metric-link">
                <div class="metric-card">
                    <div class="metric-label">Total Customers</div>
                    <div class="metric-value">@Model.TotalCustomerCount.ToString("N0")</div>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-controller="SalesOrder" asp-action="SalesOrderManagement" class="metric-link">
                <div class="metric-card">
                    <div class="metric-label">Total Sales Orders</div>
                    <div class="metric-value">@Model.TotalSalesOrderCount.ToString("N0")</div>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <div class="metric-card">
                <div class="metric-label">Orders This Month</div>
                <div class="metric-value">@Model.OrdersThisMonthCount.ToString("N0")</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="metric-card">
                <div class="metric-label">Pending Orders</div>
                <div class="metric-value">@Model.PendingOrderCount.ToString("N0")</div>
                <div class="metric-note">Except ProviderRejected, Cancelled, OnHold</div>
            </div>
        </div>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="metric-card">
                <div class="metric-label">Total Commission (Unsettled)</div>
                <div class="metric-value">@Model.TotalCommissionUnsettled.ToString("N2")</div>
                <div class="metric-note">Calculated, not finalized</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="metric-card">
                <div class="metric-label">Total Commission (Settled)</div>
                <div class="metric-value">@Model.TotalCommissionSettled.ToString("N2")</div>
                <div class="metric-note">Finalized commission</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="metric-card">
                <div class="metric-label">Received Commission</div>
                <div class="metric-value">@Model.ReceivedCommission.ToString("N2")</div>
                <div class="metric-note">Distributed to agent</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-block h-100">
                <div class="dashboard-block-header">Order Status Summary</div>

                <table class="table table-sm dashboard-table">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th class="text-end">Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.StatusSummary.Any())
                        {
                            <tr>
                                <td colspan="2" class="empty-row">No status found.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.StatusSummary)
                            {
                                <tr>
                                    <td>@item.StatusText</td>
                                    <td class="text-end">
                                        <span class="count-pill">@item.Count</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <div class="dashboard-block mb-4">
        <div class="dashboard-block-header">Recent Customers (Last 30 Days)</div>

        <div class="table-responsive">
            <table class="table table-hover dashboard-table">
                <thead>
                    <tr>
                        <th>Customer Code</th>
                        <th>Name</th>
                        <th>Mobile</th>
                        <th>Email</th>
                        <th>Registration Source</th>
                        <th>Created By</th>
                        <th>Updated By</th>
                        <th>Created Date</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.RecentCustomers.Any())
                    {
                        <tr>
                            <td colspan="8" class="empty-row">No recent customer found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.RecentCustomers)
                        {
                            <tr>
                                <td class="text-nowrap"><strong class="blue-text">@item.CustomerCode</strong></td>
                                <td>@item.CustomerName</td>
                                <td>@item.Mobile</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Email))
                                    {
                                        <a href="mailto:@item.Email" class="status-pill">@item.Email</a>
                                    }
                                </td>
                                <td>@item.RegistrationSourceText</td>
                                <td>@(item.CreatedByName ?? "-")</td>
                                <td>@(item.UpdatedByName ?? "-")</td>
                                <td class="text-nowrap">@item.CreatedAt.ToString("dd-MMM-yyyy")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="dashboard-block">
        <div class="dashboard-block-header">Recent Sales Orders (Last 30 Days)</div>

        <div class="table-responsive">
            <table class="table table-hover dashboard-table">
                <thead>
                    <tr>
                        <th>Order No</th>
                        <th>Order Date</th>
                        <th>Customer</th>
                        <th>Provider</th>
                        <th>Status</th>
                        <th>Agent</th>
                        <th>Admin</th>
                        <th class="text-end">Total</th>
                        <th>Action</th>
                    </tr>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.RecentOrders.Any())
                    {
                        <tr>
                            <td colspan="9" class="empty-row">No recent sales order found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.RecentOrders)
                        {
                            <tr>
                                <td class="text-nowrap"><strong class="blue-text">@item.OrderNo</strong></td>
                                <td class="text-nowrap">@item.OrderDate.ToString("dd-MMM-yyyy")</td>
                                <td>@item.CustomerName</td>
                                <td>@item.ProviderName</td>
                                <td>@item.StatusText</td>
                                <td>@(item.AgentDisplayName ?? "-")</td>
                                <td>@(item.AdminDisplayName ?? "-")</td>
                                <td class="text-end">@item.OrderTotal.ToString("N2")</td>
                                <td>
                                    <a asp-controller="SalesOrder"
                                       asp-action="SalesOrderCreatedSummary"
                                       asp-route-saleIds="@item.SaleId"
                                       class="btn-view">
                                        View Detail
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.getElementById('agentUserId')?.addEventListener('change', function () {
            if (this.value) {
                document.getElementById('adminUserId').value = '';
            }
        });

        document.getElementById('adminUserId')?.addEventListener('change', function () {
            if (this.value) {
                document.getElementById('agentUserId').value = '';
            }
        });
    </script>
}


