@model SuperCRM.Web.ViewModels.Providers.ProviderCreateEditViewModel

@{
    ViewData["Title"] = "Edit Provider";
}

<div class="crm-form-page">

    <h2 class="crm-page-title">Edit Provider</h2>

    <form asp-action="Edit" method="post" class="crm-form-panel">
        <input asp-for="ProviderId" type="hidden" />
        <partial name="_ProviderForm" model="Model" />
        <div class="mt-3">
            <button type="submit" class="btn crm-btn-primary">Update</button>
            <a asp-action="Index" class="btn crm-btn-secondary">Back</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}