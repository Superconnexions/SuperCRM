@model SuperCRM.Web.ViewModels.AgentManagement.AgentListViewModel

@{
    ViewData["Title"] = "Agent Management";
}

<div class="crm-page">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="crm-title mb-1">
                Agent Management
            </h3>
            <small class="crm-subtitle">
                Search, review and approve agent registrations.
            </small>
        </div>

        <span class="badge bg-primary px-3 py-2">
            Admin View
        </span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Index"
          method="get"
          class="crm-search-panel">

        <div class="row g-3 align-items-end">

            <div class="col-md-4">
                <label asp-for="SearchText" class="form-label"></label>
                <input asp-for="SearchText"
                       class="form-control"
                       placeholder="Agent Code, Email, First Name, Last Name, Phone No, Mobile No" />
            </div>

            <div class="col-md-3">
                <label asp-for="IsApproved" class="form-label"></label>
                <select asp-for="IsApproved"
                        asp-items="Model.IsApprovedOptions"
                        class="form-select">
                </select>
            </div>

            <div class="col-md-3">
                <label asp-for="RegistrationStatus" class="form-label"></label>
                <select asp-for="RegistrationStatus"
                        asp-items="Model.RegistrationStatusOptions"
                        class="form-select">
                </select>
            </div>

            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit"
                        class="btn crm-action-btn w-50">
                    Search
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary w-50">
                    Reset
                </a>
            </div>

        </div>
    </form>

    <div class="crm-grid-panel">
        <div class="table-responsive">
            <table class="crm-grid-table">
                <thead>
                    <tr>
                        <th>Agent Code</th>
                        <th>Email</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Phone No</th>
                        <th>Mobile No</th>
                        <th>Is Approved</th>
                        <th>Registration Status</th>
                        <th style="width:100px;">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <strong>@item.AgentCode</strong>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Email))
                                    {
                                        <a href="mailto:@item.Email" class="text-decoration-underline">
                                            @item.Email
                                        </a>
                                    }
                                </td>

                                <td>@item.FirstName</td>
                                <td>@item.LastName</td>
                                <td>@item.PhoneNo</td>
                                <td>@item.MobileNo</td>

                                <td>
                                    @if (item.IsApprovedText == "Yes")
                                    {
                                        <span class="crm-status-badge">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="crm-status-badge">No</span>
                                    }
                                </td>

                                <td>
                                    <span class="crm-status-badge">
                                        @item.RegistrationStatusName
                                    </span>
                                </td>

                                <td>
                                    <a asp-action="ViewRegistration"
                                       asp-route-id="@item.AgentId"
                                       class="btn btn-sm crm-action-btn">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9"
                                class="text-center crm-subtitle py-4">
                                No agents found.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>