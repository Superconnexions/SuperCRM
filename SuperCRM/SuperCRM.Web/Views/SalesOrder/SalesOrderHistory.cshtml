@model SuperCRM.Web.ViewModels.SalesOrders.SalesOrderHistoryViewModel

@{
    ViewData["Title"] = "Sales Order History";
    var startRecord = Model.TotalRecords == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var endRecord = Math.Min(Model.Page * Model.PageSize, Model.TotalRecords);
}

<style>
    body {
        background: #1f2123;
    }

    .sales-history-page {
        background: #1f2123;
        color: #d6d6d6;
        padding: 20px;
        min-height: calc(100vh - 70px);
    }

    /* Font setting */

    .history-title {
        color: #0d47ff;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .4px;
        font-size: 18pt;
    }

    .history-subtitle {
        color: #b5b5b5;
        font-size: 14pt;
    }

    .dashboard-table thead th {
        font-size: 10pt;
        font-weight: 800;
    }

    /* END Font setting */

    .history-title {
        color: #0d47ff;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .history-subtitle {
        color: #b5b5b5;
        font-size: 22px;
        font-weight: 400;
    }

    .blue-count {
        color: #0d47ff;
        font-weight: 900;
    }

    .filter-panel {
        background: #1f2123;
        border-radius: 14px;
        padding: 22px 10px 18px 10px;
        margin-bottom: 12px;
    }

    .filter-label {
        color: #d6d6d6;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .filter-control {
        background: #151719;
        border: 3px solid #3b3f44;
        border-radius: 16px;
        color: #d6d6d6;
        height: 48px;
        font-weight: 700;
    }

        .filter-control:focus {
            background: #151719;
            color: #ffffff;
            border-color: #0d47ff;
            box-shadow: none;
        }

    .btn-search {
        background: #101214;
        color: #ffffff;
        border: 5px solid #484b50;
        border-radius: 18px;
        height: 54px;
        font-weight: 900;
        min-width: 130px;
    }

        .btn-search:hover {
            color: #ffffff;
            border-color: #0d47ff;
        }

    .history-grid-block {
        background: #17191b;
        border-radius: 8px;
        overflow: hidden;
    }

    .history-table-wrap {
        overflow-x: auto;
        width: 100%;
    }

    .history-table {
        min-width: 1750px;
        color: #d6d6d6;
        margin-bottom: 0;
        font-size: 15px;
    }

        .history-table thead th {
            background: #000000;
            color: #d6d6d6;
            border-color: #2d3033;
            padding: 14px 12px;
            font-weight: 900;
            white-space: nowrap;
            text-align: center;
        }

        .history-table tbody td {
            border-color: #2d3033;
            padding: 16px 12px;
            vertical-align: middle;
            text-align: center;
        }

        .history-table tbody tr {
            background: #17191b;
        }

    .history-table tbody tr:nth-child(even) {
        background: #1b1d20;
    }

    .history-table tbody tr:hover {
        background: #2c3440 !important;
        color: #ffffff !important;
    }

    .history-table tbody tr:hover td {
        color: #ffffff !important;
    }

    .history-table tbody tr:hover a {
        color: #66a3ff !important;
    }

    .link-blue {
        color: #0d6efd;
        font-weight: 800;
        text-decoration: underline;
    }

    .small-muted-dark {
        color: #b5b5b5;
        font-size: 12px;
    }

    .status-pill {
        color: #ffffff;
        background: #0d47ff;
        border-radius: 18px;
        padding: 5px 12px;
        font-weight: 800;
        display: inline-block;
        min-width: 80px;
    }

    .pill-success {
        background: #047857;
    }

    .pill-warning {
        background: #b45309;
    }

    .pill-danger {
        background: #991b1b;
    }

    .pill-info {
        background: #0d47ff;
    }

    .pagination-panel {
        background: #1f2123;
        border-top: 2px solid #3b3f44;
        padding: 16px 0 0 0;
        margin-top: 18px;
    }

    .paging-info {
        color: #d6d6d6;
        font-size: 18px;
        font-weight: 800;
    }

    .pagination .page-link {
        background: #1f2123;
        color: #d6d6d6;
        border: 1px solid #3b3f44;
        font-weight: 800;
        padding: 10px 16px;
    }

    .pagination .page-item.active .page-link {
        background: #0d47ff;
        border-color: #0d47ff;
        color: #ffffff;
    }

    .pagination .page-item.disabled .page-link {
        background: #1f2123;
        color: #6b7280;
        border-color: #3b3f44;
    }

    .text-nowrap {
        white-space: nowrap;
    }

</style>

<div class="sales-history-page">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <span class="history-title">
                @(Model.IsAgentView ? "My Sales Order History" : "Sales Order History")
            </span>
            <span class="history-subtitle">
                | Total Orders:
                <span class="blue-count">@Model.TotalRecords</span>
            </span>
        </div>

        <div>
            @if (Model.IsAgentView)
            {
                <span class="status-pill pill-info">My Sales Orders</span>
            }
            else
            {
                <span class="status-pill pill-success">All Sales Orders</span>
            }
        </div>
    </div>

    <form asp-action="SalesOrderHistory"
          asp-controller="SalesOrder"
          method="get"
          class="filter-panel">

        <div class="row g-3 align-items-end">

            <div class="col-md-2">

                    <label class="filter-label">

                        Sales Order No

                    </label>

                    <input asp-for="SalesOrderNo" name="SalesOrderNo" class="form-control filter-control" placeholder="eg. SO-2606-5765" />

                </div>

            <div class="col-md-3">
                <label class="filter-label">Order Date From</label>
                <input type="date"
                       name="orderDateFrom"
                       value="@(Model.OrderDateFrom?.ToString("yyyy-MM-dd"))"
                       class="form-control filter-control" />
            </div>

            <div class="col-md-3">
                <label class="filter-label">Order Date To</label>
                <input type="date"
                       name="orderDateTo"
                       value="@(Model.OrderDateTo?.ToString("yyyy-MM-dd"))"
                       class="form-control filter-control" />
            </div>

            <div class="col-md-2">
                <label class="filter-label">Sales Order Status</label>
                <select name="salesOrderStatus" class="form-select filter-control">
                    <option value="">All Status</option>
                    @foreach (var item in Model.StatusOptions)
                    {
                        <option value="@item.Value" selected="@(Model.SalesOrderStatus?.ToString() == item.Value)">
                            @item.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-1">
                <label class="filter-label">Page Size</label>
                <select name="pageSize" class="form-select filter-control">
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    <option value="100" selected="@(Model.PageSize == 100)">100</option>
                </select>
            </div>

            <div class="col-md-1 text-end">
                <input type="hidden" name="page" value="1" />
                <button type="submit" class="btn crm-btn-warning">
                    Search
                </button>
            </div>

        </div>
    </form>

    <div class="history-grid-block">
        <div class="history-table-wrap">
            <table class="table table-bordered table-hover align-middle history-table">
                <thead>
                    <tr>
                        <th>Order No</th>
                        <th>Order Date</th>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Mobile</th>
                        <th>Provider</th>
                        <th>Status</th>
                        <th>Commission Applicable</th>
                        <th>Commission Finalized</th>
                        <th>Service Start</th>
                        <th>Next Renew</th>
                        <th>No Of Renew</th>
                        <th>Order Total</th>
                        <th>Agent Commission</th>
                        <th>Lines</th>
                        <th>Email Sent</th>
                        <th>Agent Code</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Orders.Any())
                    {
                        <tr>
                            <td colspan="17" class="text-center py-4">
                                No sales order found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Orders)
                        {
                            var commissionClass = item.IsCommissionApplicable
                            ? "pill-success"
                            : "pill-danger";

                            var finalizedClass = item.CommissionFinalizedText == "Yes"
                            ? "pill-success"
                            : item.CommissionFinalizedText == "Partial"
                            ? "pill-warning"
                            : "pill-danger";

                            <tr>
                                <td class="text-nowrap">
                                    <a href="javascript:void(0);"
                                       class="@(item.HasSpecialNotes ? "order-has-notes" : "link-blue") btn-view-sales-summary"
                                       data-sale-id="@item.SaleId"
                                       data-order-no="@item.OrderNo"
                                       data-bs-toggle="modal"
                                       data-bs-target="#salesOrderSummaryModal">

                                        <strong>@item.OrderNo</strong>

                                    </a>

                                    @if (item.HasSpecialNotes)
                                    {
                                        <span class="notes-badge">
                                            Notes
                                        </span>
                                    }
                                </td>

                                <td class="text-nowrap">
                                    @item.OrderDate.ToString("dd-MMM-yyyy")
                                </td>

                                <td>
                                    <div>@item.CustomerName</div>
                                    <small class="small-muted-dark">@item.CustomerCode</small>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.CustomerEmail))
                                    {
                                        <a href="mailto:@item.CustomerEmail" class="link-blue">
                                            @item.CustomerEmail
                                        </a>
                                    }
                                </td>

                                <td class="text-nowrap">@item.CustomerMobile</td>

                                <td>@item.ProviderName</td>

                                <td>
                                    <span class="status-pill pill-info">
                                        @item.SalesOrderStatusText
                                    </span>
                                </td>

                                <td>
                                    <span class="status-pill @commissionClass">
                                        @item.CommissionApplicableText
                                    </span>
                                </td>

                                <td>
                                    <span class="status-pill @finalizedClass">
                                        @item.CommissionFinalizedText
                                    </span>
                                </td>

                                <td class="text-nowrap">
                                    @(item.ServiceStartDate?.ToString("dd-MMM-yyyy") ?? "-")
                                </td>

                                <td class="text-nowrap">
                                    @(item.NextRenewDate?.ToString("dd-MMM-yyyy") ?? "-")
                                </td>

                                <td>@item.NoOfRenew</td>

                                <td class="text-end text-nowrap">
                                    @item.OrderTotal.ToString("N2")
                                </td>

                                <td class="text-end text-nowrap">
                                    @item.AgentCommissionAmount.ToString("N2")
                                </td>

                                <td>
                                    <small>
                                        Total: @item.TotalLines<br />
                                        Completed: @item.CompletedLines<br />
                                        Cancel/Reject: @item.CancelledOrRejectedLines
                                    </small>
                                </td>

                                <td>
                                    <small>
                                        Customer: @(item.EmailSentToCustomer ? "Yes" : "No")<br />
                                        Provider: @(item.EmailSentToProvider ? "Yes" : "No")
                                    </small>
                                </td>

                                <td class="text-nowrap">
                                    @(item.SoldByAgentCode ?? "-")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="pagination-panel d-flex justify-content-between align-items-center">
        <div class="paging-info">
            Showing @startRecord to @endRecord of @Model.TotalRecords entries
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav>
                <ul class="pagination mb-0">

                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="SalesOrderHistory"
                           asp-route-orderDateFrom="@(Model.OrderDateFrom?.ToString("yyyy-MM-dd"))"
                           asp-route-orderDateTo="@(Model.OrderDateTo?.ToString("yyyy-MM-dd"))"
                           asp-route-salesOrderStatus="@Model.SalesOrderStatus"
                           asp-route-salesOrderNo="@Model.SalesOrderNo"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-pageSize="@Model.PageSize">
                            Previous
                        </a>
                    </li>

                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == 1 || i == Model.TotalPages || Math.Abs(i - Model.Page) <= 2)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                <a class="page-link"
                                   asp-action="SalesOrderHistory"
                                   asp-route-orderDateFrom="@(Model.OrderDateFrom?.ToString("yyyy-MM-dd"))"
                                   asp-route-orderDateTo="@(Model.OrderDateTo?.ToString("yyyy-MM-dd"))"
                                   asp-route-salesOrderStatus="@Model.SalesOrderStatus"
                                   asp-route-salesOrderNo="@Model.SalesOrderNo"
                                   asp-route-page="@i"
                                   asp-route-pageSize="@Model.PageSize">
                                    @i
                                </a>
                            </li>
                        }
                    }

                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="SalesOrderHistory"
                           asp-route-orderDateFrom="@(Model.OrderDateFrom?.ToString("yyyy-MM-dd"))"
                           asp-route-orderDateTo="@(Model.OrderDateTo?.ToString("yyyy-MM-dd"))"
                           asp-route-salesOrderStatus="@Model.SalesOrderStatus"
                           asp-route-salesOrderNo="@Model.SalesOrderNo"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-pageSize="@Model.PageSize">
                            Next
                        </a>
                    </li>

                </ul>
            </nav>
        }
    </div>

</div>



<div class="modal fade crm-modal" id="salesOrderSummaryModal" tabindex="-1">
    <div class="modal-dialog modal-fullscreen-xl-down modal-xl">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    Sales Order Summary
                    <span id="salesOrderSummaryModalOrderNo"
                          class="ms-2 text-warning fw-bold">
                    </span>
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body" id="salesOrderSummaryModalBody">
                <div class="crm-subtitle">
                    Loading...
                </div>
            </div>

        </div>
    </div>
</div>


@section Scripts {
    <script>

        document.addEventListener('click', async function (e) {

            const btn = e.target.closest('.btn-view-sales-summary');

            if (!btn) return;

            const saleId = btn.dataset.saleId;
            const orderNo = btn.dataset.orderNo;

            const titleOrderNo =
                document.getElementById('salesOrderSummaryModalOrderNo');

            const modalBody =
                document.getElementById('salesOrderSummaryModalBody');

            if (titleOrderNo) {
                titleOrderNo.innerHTML = '| ' + orderNo;
            }

            if (modalBody) {
                modalBody.innerHTML =
                    '<div class="crm-subtitle">Loading sales order summary...</div>';
            }

            try {
                const response = await fetch(
                    '/SalesOrder/SalesOrderSummaryModal?saleId=' +
                    encodeURIComponent(saleId)
                );

                if (!response.ok) {

                    modalBody.innerHTML =
                        '<div class="alert alert-danger">Unable to load sales order summary.</div>';

                        // const text = await response.text();

                        // console.log(text);

                        // modalBody.innerHTML =

                        //     '<div class="alert alert-danger">'

                        //     + response.status

                        //     + ' '

                        //     + response.statusText

                        //     + '<br/>'

                        //     + text

                        //     + '</div>';

                        return;
                }

                const html = await response.text();

                modalBody.innerHTML = html;
            }
            catch {
                modalBody.innerHTML =
                    '<div class="alert alert-danger">Unexpected error while loading sales order summary.</div>';
            }
        });

        document
            .getElementById('salesOrderSummaryModal')
            ?.addEventListener('hidden.bs.modal', function () {

                document.getElementById('salesOrderSummaryModalOrderNo').innerHTML = '';

                document.getElementById('salesOrderSummaryModalBody').innerHTML =
                    '<div class="crm-subtitle">Loading...</div>';
            });
    </script>
}
