            }

            box.innerHTML = html;
        }

        

        document.getElementById('salesOrderSearchForm')
            ?.addEventListener('submit', function(e) {

                const fromDate =
                    document.getElementById('orderDateFrom')?.value;

                const toDate =
                    document.getElementById('orderDateTo')?.value;

                if (fromDate > toDate) {
                    alert('Order Date From cannot be greater than Order Date To.');
                    e.preventDefault();
                    return false;
                }
            });

        document.getElementById('salesOrderManageModal').addEventListener('hidden.bs.modal', function() {

            document.getElementById('salesOrderNoTitle')
                .innerHTML = '';

            document.getElementById('salesOrderModalMessage')
                .innerHTML = '';

        });


        // New Changes for Modal message

        function showSalesOrderModalMessage(success, message) {

            const messageBox = document.getElementById('salesOrderModalMessage');

            if (!messageBox) return;

            const alertClass = success ? 'alert-success' : 'alert-danger';

            messageBox.innerHTML = `
                        <div class="alert ${alertClass} alert-dismissible fade show mb-3">
                            ${message || ''}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>`;
        }

        document.addEventListener('submit', async function(e) {

            const form = e.target.closest('.sales-order-modal-update-form');

            if (!form) return;

            e.preventDefault();

            const submitButton = form.querySelector('button[type="submit"]');
            const originalText = submitButton ? submitButton.innerHTML : '';

            try {

                if (submitButton) {
                    submitButton.disabled = true;
                    submitButton.innerHTML = 'Updating...';
                }

                const formData = new FormData(form);

                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const result = await response.json();

                showSalesOrderModalMessage(
                    result.success === true,
                    result.message || (result.success ? 'Updated successfully.' : 'Update failed.')
                );

            } catch (error) {

                showSalesOrderModalMessage(false, 'Unexpected error occurred while updating.');

            } finally {

                if (submitButton) {
                    submitButton.disabled = false;
                    submitButton.innerHTML = originalText;
                }
            }
        });


        /// Sale Order Details Modal

        document.addEventListener('click', async function(e) {

            const btn = e.target.closest('.btn-view-sales-summary');

            if (!btn) return;

            const saleId = btn.dataset.saleId;
            const orderNo = btn.dataset.orderNo;

            const titleOrderNo =
                document.getElementById('salesOrderSummaryModalOrderNo');

            const modalBody =
                document.getElementById('salesOrderSummaryModalBody');

            if (titleOrderNo) {
                titleOrderNo.innerHTML = '| ' + orderNo;
            }

            if (modalBody) {
                modalBody.innerHTML =
                    '<div class="crm-subtitle">Loading sales order summary...</div>';
            }

            try {
                const response = await fetch(
                    '/SalesOrder/SalesOrderSummaryModal?saleId=' +
                    encodeURIComponent(saleId)
                );

                if (!response.ok) {

                    modalBody.innerHTML =
                        '<div class="alert alert-danger">Unable to load sales order summary.</div>';

                    // const text = await response.text();

                    // console.log(text);

                    // modalBody.innerHTML =

                    //     '<div class="alert alert-danger">'

                    //     + response.status

                    //     + ' '

                    //     + response.statusText

                    //     + '<br/>'

                    //     + text

                    //     + '</div>';

                    return;
                }

                const html = await response.text();

                modalBody.innerHTML = html;
            }
            catch {
                modalBody.innerHTML =
                    '<div class="alert alert-danger">Unexpected error while loading sales order summary.</div>';
            }
        });

        document.getElementById('salesOrderSummaryModal')?.addEventListener('hidden.bs.modal', function() {

            document.getElementById('salesOrderSummaryModalOrderNo').innerHTML = '';

            document.getElementById('salesOrderSummaryModalBody').innerHTML =
                '<div class="crm-subtitle">Loading...</div>';
        });

    </script>
}