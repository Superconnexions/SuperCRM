    <input asp-for="City" class="form-control" />
    <span asp-validation-for="City" class="text-danger"></span>
</div> *@

<div class="col-md-3">
    <label asp-for="CountryId" class="form-label"></label>
    <select asp-for="CountryId" asp-items="Model.CountryOptions" class="form-select country-select">
        <option value="">-- Select Country --</option>
    </select>
    <span asp-validation-for="CountryId" class="text-danger"></span>
</div>

<div class="col-md-3">
    <label asp-for="CityId" class="form-label"></label>
    <select asp-for="CityId" asp-items="Model.CityOptions" class="form-select city-select" data-selected-city-id="@Model.CityId">
        <option value="">-- Select City --</option>
    </select>
    <span asp-validation-for="CityId" class="text-danger"></span>
</div>

<div class="col-md-6">
    <label asp-for="AddressLine" class="form-label"></label>
    <input asp-for="AddressLine" class="form-control" placeholder="Optional, any notes for address"/>
    <span asp-validation-for="AddressLine" class="text-danger"></span>
</div>