@model SuperCRM.Web.ViewModels.ProductVariantTypes.ProductVariantTypeCreateEditViewModel

@{
    ViewData["Title"] = "Add Product Variant Type";
}

<div class="crm-form-page">

<h2 class="crm-form-title">Add Product Variant Type</h2>

<form asp-action="Create" class="crm-form-panel" method="post">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn crm-btn-primary">Save</button>
    <a asp-action="Index" class="btn crm-btn-secondary">Back</a>
</form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}