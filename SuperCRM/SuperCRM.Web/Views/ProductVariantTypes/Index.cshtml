@model IEnumerable<SuperCRM.Web.ViewModels.ProductVariantTypes.ProductVariantTypeListItemViewModel>

@{
    ViewData["Title"] = "Product Variant Types";
}

<div class="crm-page">

    
<h2 class="crm-page-title">Product Variant Types</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="mb-3 text-end">
    <a asp-action="Create" class="btn crm-btn-primary">Add Product Variant Type</a>
</div>

<div class="crm-grid-panel">

<table class="crm-grid-table">
    <thead>
        <tr>
            <th>Type Code</th>
            <th>Type Value</th>
            <th>Display Order</th>
            <th>Active</th>
            <th style="width:120px;">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TypeCode</td>
                <td>@item.TypeValue</td>
                <td>@item.DisplayOrder</td>
                <td>@(item.IsActive ? "Yes" : "No")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.TypeCode" class="btn btn-sm crm-btn-warning">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
</div>