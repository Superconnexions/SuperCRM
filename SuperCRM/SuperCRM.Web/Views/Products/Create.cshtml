@model SuperCRM.Web.ViewModels.Products.ProductCreateEditViewModel

@{
    ViewData["Title"] = "Add Product";
}

<div class="crm-form-page">

<h2 class="crm-form-title">Add Product</h2>

    <form asp-action="Create" method="post" class="crm-form-panel" enctype="multipart/form-data">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn crm-btn-primary">Save</button>
        <a asp-action="Index" class="btn crm-btn-secondary">Back</a>
</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/products-form.js"></script>
}

