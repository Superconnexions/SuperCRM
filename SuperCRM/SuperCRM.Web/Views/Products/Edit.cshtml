@model SuperCRM.Web.ViewModels.Products.ProductCreateEditViewModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="crm-form-page">

<h2 class="crm-form-title">Edit Product</h2>

    <form asp-action="Edit" method="post" class="crm-form-panel" enctype="multipart/form-data">
        <input asp-for="ProductId" type="hidden" />
        <partial name="_Form" model="Model" />
        <button type="submit" class="btn crm-btn-primary">Update</button>
        <a asp-action="Index" class="btn crm-btn-secondary">Back</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/products-form.js"></script>
}

