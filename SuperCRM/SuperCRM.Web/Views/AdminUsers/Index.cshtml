@model IEnumerable<SuperCRM.Web.ViewModels.AdminUsers.AdminUserListItemViewModel>

@{
ViewData["Title"] = "Admin Users";
}

<div class="crm-page">


<h2 class="crm-page-title">
    Admin Users
</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-3">
        @TempData["SuccessMessage"]
    </div>
}

<div class="mb-3 text-end">
    <a asp-action="Create"
       class="btn crm-grid-btn-primary">
        Create Admin User
    </a>
</div>

<div class="crm-grid-panel">

    <table class="crm-grid-table">

        <thead>
            <tr>
                <th>Email</th>
                <th>User Name</th>
                <th>Role</th>
                <th>Active</th>
                <th>Created At (UTC)</th>
                <th style="width:120px;">Action</th>
            </tr>
        </thead>

        <tbody>

            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Email</td>

                        <td>@item.UserName</td>

                        <td>
                            <span class="crm-status-badge">
                                @item.RoleName
                            </span>
                        </td>

                        <td>
                            @(item.IsActive ? "Yes" : "No")
                        </td>

                        <td>
                            @item.CreatedAt.ToString("dd-MMM-yyyy HH:mm")
                        </td>

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@item.UserId"
                               class="btn btn-sm crm-grid-btn-warning">
                                Edit
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6"
                        style="text-align:center;padding:20px;">
                        No admin users found.
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>


</div>
