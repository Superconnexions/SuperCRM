@model SuperCRM.Web.ViewModels.ProductCategories.ProductCategoryCreateEditViewModel

@{
    ViewData["Title"] = "Edit Product Category";
}

<div class="crm-form-page">

<h1 class="crm-form-title">Edit Product Category</h1>

    <form asp-action="Edit" method="post" class="crm-form-panel">
        <input asp-for="CategoryId" type="hidden" />
        <partial name="_Form" model="Model" />
        <button type="submit" class="btn crm-btn-primary">Update</button>
        <a asp-action="Index" class="btn btn-sm crm-btn-warning">Back to List</a>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
