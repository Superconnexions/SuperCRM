@model IEnumerable<SuperCRM.Web.ViewModels.ProductCategories.ProductCategoryListItemViewModel>

@{
    ViewData["Title"] = "Product Categories";
}

<div class="crm-page">


    <h2 class="crm-page-title">Product Categories</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="mb-3 text-end">
        <a asp-action="Create" class="btn crm-btn-primary">Add Product Category</a>
    </div>

    <div class="crm-grid-panel">

        <table class="crm-grid-table">
            <thead>
                <tr>
                    <th>Category Code</th>
                    <th>Category Name</th>
                    <th>Image URL</th>
                    <th>Display Order</th>
                    <th>Active</th>
                    <th style="width:120px;">Action</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CategoryCode</td>
                    <td>@item.CategoryName</td>
                    <td>@item.CategoryImageUrl</td>
                    <td>@item.DisplayOrder</td>
                    <td>@(item.IsActive ? "Yes" : "No")</td>
                    <td>
                            <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm crm-btn-warning">Edit</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>