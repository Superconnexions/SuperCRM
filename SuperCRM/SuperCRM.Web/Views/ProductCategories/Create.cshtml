@model SuperCRM.Web.ViewModels.ProductCategories.ProductCategoryCreateEditViewModel

@{
    ViewData["Title"] = "Add Product Category";
}

<div class="crm-form-page">

    <h1 class="crm-form-title">
        Add Product Category
     </h1>

    <form asp-action="Create" method="post" class="crm-form-panel">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn crm-btn-primary">Save</button>
        <a asp-action="Index" class="btn crm-btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
