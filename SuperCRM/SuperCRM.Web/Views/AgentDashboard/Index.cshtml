@model SuperCRM.Application.DTOs.SalesOrders.AgentDashboardDto

@{
    ViewData["Title"] = "Agent Dashboard";
}

<style>
    body {
        background: #222426;
    }

    .agent-dashboard {
        background: #222426;
        color: #d6d6d6;
        padding: 18px;
        min-height: calc(100vh - 70px);
    }

    .dashboard-title {
        color: #0d47ff;
        font-weight: 800;
        letter-spacing: .5px;
        margin-bottom: 4px;
        text-transform: uppercase;
    }

    .dashboard-subtitle {
        color: #b5b5b5;
        font-size: 16px;
    }

    .blue-text {
        color: #0d47ff;
        font-weight: 800;
    }

    .top-action-btn {
        background: #101214;
        color: #ffffff;
        border: 6px solid #484b50;
        border-radius: 18px;
        padding: 12px 28px;
        font-weight: 800;
        text-decoration: none;
    }

        .top-action-btn:hover {
            color: #ffffff;
            border-color: #0d47ff;
        }

    .metric-card {
        background: #17191b;
        border: 2px solid #2d3033;
        border-radius: 10px;
        min-height: 120px;
        padding: 18px;
    }

        .metric-card:hover {
            border-color: #0d47ff;
        }

    .metric-label {
        color: #ffffff;
        font-weight: 800;
        font-size: 15px;
    }

    .metric-value {
        color: #0d47ff;
        font-size: 34px;
        font-weight: 900;
        margin-top: 10px;
        line-height: 1;
    }

    .metric-note {
        color: #c8c8c8;
        font-size: 12px;
        margin-top: 10px;
    }

    .metric-link {
        text-decoration: none;
    }

    .dashboard-block {
        background: #17191b;
        border: 2px solid #2d3033;
        border-radius: 8px;
        overflow: hidden;
    }

    .dashboard-block-header {
        background: #000000;
        color: #ffffff;
        font-weight: 800;
        padding: 14px 18px;
        font-size: 17px;
    }

    .dashboard-table {
        color: #d6d6d6;
        margin-bottom: 0;
        font-size: 15px;
    }

        .dashboard-table thead th {
            background: #000000;
            color: #d6d6d6;
            border-color: #2d3033;
            padding: 14px;
            font-weight: 800;
            white-space: nowrap;
        }

        .dashboard-table tbody td {
            border-color: #2d3033;
            padding: 14px;
            vertical-align: middle;
        }

        .dashboard-table tbody tr {
            background: #17191b;
        }

            .dashboard-table tbody tr:nth-child(even) {
                background: #1b1d20;
            }

            .dashboard-table tbody tr:hover {
                background: #20242b;
            }

    .status-pill {
        color: #0d6efd;
        font-weight: 800;
        text-decoration: underline;
    }

    .count-pill {
        color: #ffffff;
        background: #0d47ff;
        border-radius: 18px;
        padding: 4px 12px;
        font-weight: 800;
    }

    .empty-row {
        text-align: center;
        color: #b5b5b5;
        padding: 20px !important;
    }

    .btn-view {
        color: #0d6efd;
        font-weight: 800;
        text-decoration: underline;
        background: transparent;
        border: none;
        padding: 0;
    }

        .btn-view:hover {
            color: #4d8bff;
        }

    .text-nowrap {
        white-space: nowrap;
    }
</style>

<div class="agent-dashboard">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="dashboard-title">Agent Dashboard</h3>
            <div class="dashboard-subtitle">
                Track your customers, sales orders and commission performance.
            </div>
        </div>

        <a asp-controller="SalesOrder"
           asp-action="SalesOrderProductList"
           class="top-action-btn">
            Create Sales Order
        </a>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <a asp-controller="SalesOrder"
               asp-action="CustomerManagement"
               class="metric-link">
                <div class="metric-card">
                    <div class="metric-label">My Customers</div>
                    <div class="metric-value">@Model.MyCustomerCount.ToString("N0")</div>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-controller="SalesOrder"
               asp-action="SalesOrderHistory"
               class="metric-link">
                <div class="metric-card">
                    <div class="metric-label">My Sales Orders</div>
                    <div class="metric-value">@Model.MySalesOrderCount.ToString("N0")</div>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <div class="metric-card">
                <div class="metric-label">Orders This Month</div>
                <div class="metric-value">@Model.OrdersThisMonthCount.ToString("N0")</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="metric-card">
                <div class="metric-label">Pending Orders</div>
                <div class="metric-value">@Model.PendingOrderCount.ToString("N0")</div>
                <div class="metric-note">
                    Except ProviderRejected, Cancelled, OnHold
                </div>
            </div>
        </div>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="metric-card">
                <div class="metric-label">Total Commission (Unsettled)</div>
                <div class="metric-value">@Model.TotalCommissionUnsettled.ToString("N2")</div>
                <div class="metric-note">Calculated, not finalized</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="metric-card">
                <div class="metric-label">Total Commission (Settled)</div>
                <div class="metric-value">@Model.TotalCommissionSettled.ToString("N2")</div>
                <div class="metric-note">Finalized commission</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="metric-card">
                <div class="metric-label">Received Commission</div>
                <div class="metric-value">@Model.ReceivedCommission.ToString("N2")</div>
                <div class="metric-note">Distributed to agent</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-block h-100">
                <div class="dashboard-block-header">
                    Order Status Summary
                </div>

                <table class="table table-sm dashboard-table">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th class="text-end">Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.StatusSummary.Any())
                        {
                            <tr>
                                <td colspan="2" class="empty-row">No status found.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.StatusSummary)
                            {
                                <tr>
                                    <td>@item.StatusText</td>
                                    <td class="text-end">
                                        <span class="count-pill">@item.Count</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <div class="dashboard-block mb-4">
        <div class="dashboard-block-header">
            Recent Customers (Last 30 Days)
        </div>

        <div class="table-responsive">
            <table class="table table-hover dashboard-table">
                <thead>
                    <tr>
                        <th>Customer Code</th>
                        <th>Name</th>
                        <th>Mobile</th>
                        <th>Email</th>
                        <th>Registration Source</th>
                        <th>Created Date</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.RecentCustomers.Any())
                    {
                        <tr>
                            <td colspan="6" class="empty-row">No recent customer found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.RecentCustomers)
                        {
                            <tr>
                                <td class="text-nowrap">
                                    <strong class="blue-text">@item.CustomerCode</strong>
                                </td>
                                <td>@item.CustomerName</td>
                                <td>@item.Mobile</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Email))
                                    {
                                        <a href="mailto:@item.Email" class="status-pill">@item.Email</a>
                                    }
                                </td>
                                <td>@item.RegistrationSourceText</td>
                                <td class="text-nowrap">@item.CreatedAt.ToString("dd-MMM-yyyy")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="dashboard-block">
        <div class="dashboard-block-header">
            Recent Sales Orders (Last 30 Days)
        </div>

        <div class="table-responsive">
            <table class="table table-hover dashboard-table">
                <thead>
                    <tr>
                        <th>Order No</th>
                        <th>Order Date</th>
                        <th>Customer</th>
                        <th>Provider</th>
                        <th>Status</th>
                        <th class="text-end">Total</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.RecentOrders.Any())
                    {
                        <tr>
                            <td colspan="7" class="empty-row">No recent sales order found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.RecentOrders)
                        {
                            <tr>
                                <td class="text-nowrap">
                                    <strong class="blue-text">@item.OrderNo</strong>
                                </td>

                                <td class="text-nowrap">
                                    @item.OrderDate.ToString("dd-MMM-yyyy")
                                </td>

                                <td>@item.CustomerName</td>

                                <td>@item.ProviderName</td>

                                <td>@item.StatusText</td>

                                <td class="text-end">
                                    @item.OrderTotal.ToString("N2")
                                </td>

                                <td>
                                    <a asp-controller="SalesOrder"
                                       asp-action="SalesOrderCreatedSummary"
                                       asp-route-saleIds="@item.SaleId"
                                       class="btn-view">
                                        View Detail
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>