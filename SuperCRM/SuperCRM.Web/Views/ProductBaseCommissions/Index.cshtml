@model SuperCRM.Web.ViewModels.ProductBaseCommissions.ProductBaseCommissionIndexViewModel

@{
ViewData["Title"] = "Product Base Commission";
}

<div class="crm-page">

<h2 class="crm-page-title">
    Product Base Commission
</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-3">
        @TempData["SuccessMessage"]
    </div>
}

<form method="get" class="crm-search-panel mb-3">

    <div class="row g-3">

        <div class="col-md-4">
            <label asp-for="ProductKeyword" class="form-label"></label>
            <input asp-for="ProductKeyword"
                   class="form-control"
                   placeholder="Product code or product name" />
        </div>

       @*  <div class="col-md-2">
            <label asp-for="EffectiveFrom" class="form-label"></label>
            <input asp-for="EffectiveFrom"
                   type="date"
                   class="form-control" />
        </div>

        <div class="col-md-2">
            <label asp-for="EffectiveTo" class="form-label"></label>
            <input asp-for="EffectiveTo"
                   type="date"
                   class="form-control" />
        </div> *@
@* 
        <div class="col-md-2 d-flex align-items-end">
            <div class="form-check">
                <input asp-for="IncludeInactive"
                       class="form-check-input" />
                <label asp-for="IncludeInactive"
                       class="form-check-label">
                </label>
            </div>
        </div>
 *@
        <div class="col-md-2 d-flex align-items-end gap-2">
            <button type="submit"
                    class="btn crm-grid-btn-primary">
                Search
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Reset
            </a>
        </div>

    </div>

</form>

<div class="mb-3 text-end">
    <a asp-action="Create"
       class="btn btn-success">
        Create New
    </a>
</div>

<div class="crm-grid-panel">

    <table class="crm-grid-table">

        <thead>
            <tr>
                <th>Product Code</th>
                <th>Product Name</th>
                <th>Commission Type</th>
                <th>Fixed Amount</th>
                <th>Percentage</th>
                <th>Effective From</th>
                <th>Effective To</th>
                <th>Currency</th>
                <th>Is Active</th>
                <th style="width:220px;">Actions</th>
            </tr>
        </thead>

        <tbody>

            @if (Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductCode</td>
                        <td>@item.ProductName</td>
                        <td>@item.CommissionType</td>
                        <td>@item.FixedAmount</td>
                        <td>@item.Percentage</td>
                        <td>@item.EffectiveFrom?.ToString("yyyy-MM-dd")</td>
                        <td>@item.EffectiveTo?.ToString("yyyy-MM-dd")</td>
                        <td>@item.CurrencyCode</td>
                        <td>@item.IsActive</td>

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@item.ProductBaseCommissionId"
                               class="btn btn-sm crm-grid-btn-primary">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.ProductBaseCommissionId"
                               class="btn btn-sm btn-danger">
                                Delete
                            </a>

                            <a asp-action="History"
                               asp-route-id="@item.ProductBaseCommissionId"
                               class="btn btn-sm btn-info">
                                Change History
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10"
                        style="text-align:center;padding:20px;">
                        No records found.
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>


</div>
