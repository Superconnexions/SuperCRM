@model SuperCRM.Web.ViewModels.ProductBaseCommissions.ProductVariantCommissionOverrideCreateEditViewModel

@{
    ViewData["Title"] = "Create Product Variant Commission";
}

<div class="crm-form-page">

    <h2 class="crm-form-title">
        Create Product Variant Commission
    </h2>

    <form asp-action="CreateVariantOverride"
          method="post"
          class="crm-form-panel">

        @Html.AntiForgeryToken()

        <partial name="_VariantOverrideForm" model="Model" />

        <div class="mt-3">
            <button type="submit" class="btn crm-btn-primary">
                Save
            </button>

            <a asp-action="VariantOverrides" class="btn crm-btn-back">
                Back to List
            </a>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_VariantOverrideScripts" />
}