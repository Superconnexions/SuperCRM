@model SuperCRM.Web.ViewModels.EmailSettings.EmailSettingCreateEditViewModel

@{
    ViewData["Title"] = "Edit Email Setting";
}
<div class="crm-form-page">

<h2 class="crm-form-title">Edit Email Setting</h2>

<form asp-action="Edit" method="post" class="crm-form-panel">
    <input type="hidden" asp-for="EmailSettingId" />
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn crm-btn-primary">Update</button>
        <a asp-action="Index" class="btn btn-sm crm-btn-warning">Back to List</a>
</form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
