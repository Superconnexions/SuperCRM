@model SuperCRM.Web.ViewModels.SalesUnits.SalesUnitCreateEditViewModel

@{
    ViewData["Title"] = "Add Sales Unit";
}

<div class="crm-form-page">

    <h2 class="crm-form-title">Add Sales Unit</h2>

    <form asp-action="Create" class="crm-form-panel" method="post">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn crm-btn-primary">Save</button>
    <a asp-action="Index" class="btn crm-btn-secondary">Back</a>
</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
