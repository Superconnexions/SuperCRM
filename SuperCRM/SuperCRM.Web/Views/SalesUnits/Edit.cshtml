@model SuperCRM.Web.ViewModels.SalesUnits.SalesUnitCreateEditViewModel

@{
    ViewData["Title"] = "Edit Sales Unit";
}

<div class="crm-form-page">

<h2 class="crm-form-title">Edit Sales Unit</h2>

<form asp-action="Edit" class="crm-form-panel" method="post">
